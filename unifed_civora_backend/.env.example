# ==============================================================================
# CIVORA BACKEND ENVIRONMENT CONFIGURATION (.env.example)
# ==============================================================================
# Allowed values: development | staging | production | test
CIVORA_ENV=development
DEBUG=True
SECRET_KEY=replace-with-a-strong-random-secret-key-at-least-32-characters

ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# ==============================================================================
# DATABASE (PostgreSQL Primary)
# ==============================================================================
# Leave DATABASE_URL empty in local dev if USE_SQLITE_FALLBACK=True, or point to PostgreSQL:
DATABASE_URL=postgres://postgres:postgres@localhost:5432/civora_db
USE_SQLITE_FALLBACK=True
DB_CONN_MAX_AGE=60

# ==============================================================================
# MULTI-REPOSITORY CORS ALLOWED ORIGINS
# ==============================================================================
# 1. Civora-PE_and_Stakeholder_Frontend (http://localhost:3000)
# 2. Civora-Admin_Frontend (http://localhost:3001)
# 3. Civora_Mobile_App (http://localhost:8081)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:8081,http://127.0.0.1:3000,http://127.0.0.1:3001

# ==============================================================================
# JWT, SESSION & DEDICATED PLATFORM ADMIN CREDENTIALS
# ==============================================================================
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7

# Dedicated Platform Admin credentials (used by seed_dev and admin bootstrap).
# Override these in your local .env or production secrets manager:
CIVORA_ADMIN_EMAIL=admin@civora.internal
CIVORA_ADMIN_PASSWORD=Civora2026!
CIVORA_ADMIN_NAME=Engr. Babatunde Fashola-Smith

# ==============================================================================
# CELERY & REDIS (Async Jobs, Webhooks, PDF Rendering, AI)
# ==============================================================================
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ==============================================================================
# PRIVATE OBJECT STORAGE (S3 / GCS / MinIO — Phase 5)
# ==============================================================================
STORAGE_BUCKET_NAME=civora-evidence-private
STORAGE_REGION=eu-west-1

# ==============================================================================
# WHATSAPP BUSINESS PLATFORM (Phase 6)
# ==============================================================================
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# ==============================================================================
# AI PROVIDER CONFIGURATION (Phase 9)
# ==============================================================================
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL_ID=gemini-2.5-pro

